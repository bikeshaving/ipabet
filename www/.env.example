# AWS credentials for the Polly audio bake (scripts/bake-audio.ts).
#
# 1. Copy this file to `.env`  (which is gitignored — it will NOT be committed):
#      cp .env.example .env
# 2. Create a key: IAM console → Users → Security credentials → Create access key
#    → "Command Line Interface" → copy the two values into `.env` below.
# 3. Run the bake from this directory (www/): `bun scripts/bake-audio.ts`
#    Bun auto-loads `.env`, and the AWS SDK reads these vars — no global `aws configure`.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
