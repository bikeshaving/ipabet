 "modifiers": {
  "H": "lenite toward /h/ — spirantize consonants (sH→ʃ, tH→θ); vowels lax (iH→ɪ, uH→ʊ) or, for a, back (aH→ɑ)",
  "R": "retroflex (coronals); trill (elsewhere)",
  "J": "palatalize (consonants only)",
  "W": "labialize / round-flip",
  "L": "lateralize",
  "G": "dorsal deepening — velar/uvular place",
  "Q": "guttural — uvular-pharyngeal-epiglottal throat region",
  "V": "labiodental",
  "B": "bilabial place",
  "A": "drag toward a (vowels: oA→ɒ, uA→ʌ, 5A→ɐ)",
  "Y": "central — the y-vowels (iY→ɨ, uY→ʉ, eY→ɘ, oY→ɵ); Welsh y, Russian ы",
  "E": "ligature with e",
  "C": "click — base letter is the anterior place (p bilabial, t dental, q alveolar, c palatal, l lateral)",
  "P": "implosive (voiced glottalic ingressive)"
