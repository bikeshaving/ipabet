    <key id="mk_caron-below" output="\m{caron-below}"/>
    <key id="mk_macron" output="\m{macron}"/>
    <key id="mk_macron-below" output="\m{macron-below}"/>
    <key id="mk_tilde" output="\m{tilde}"/>
    <key id="mk_tilde-below" output="\m{tilde-below}"/>
    <key id="mk_diaeresis" output="\m{diaeresis}"/>
    <key id="mk_diaeresis-below" output="\m{diaeresis-below}"/>
    <key id="mk_breve" output="\m{breve}"/>
    <key id="mk_breve-below" output="\m{breve-below}"/>
    <key id="mk_ring-above" output="\m{ring-above}"/>
    <key id="mk_ring-below" output="\m{ring-below}"/>
    <key id="mk_cedilla" output="\m{cedilla}"/>
    <key id="mk_palatal-hook-below" output="\m{palatal-hook-below}"/>
    <key id="mk_comma-below" output="\m{comma-below}"/>
    <key id="mk_comma-above" output="\m{comma-above}"/>
