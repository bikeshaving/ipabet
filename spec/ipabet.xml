    <!-- option layer (⌥): combining dead-key markers and spacing marks, by key position -->
    <key id="mk_acute" output="\m{acute}"/>
    <key id="mk_double-acute" output="\m{double-acute}"/>
    <key id="mk_grave" output="\m{grave}"/>
    <key id="mk_double-grave" output="\m{double-grave}"/>
