    <key id="mk_stroke-overlay" output="\m{stroke-overlay}"/>
    <key id="mk_tilde-overlay" output="\m{tilde-overlay}"/>
    <key id="mk_down-tack-below" output="\m{down-tack-below}"/>
    <key id="mk_up-tack-below" output="\m{up-tack-below}"/>
    <key id="mk_left-half-ring-below" output="\m{left-half-ring-below}"/>
    <key id="mk_right-half-ring-below" output="\m{right-half-ring-below}"/>
    <key id="mk_vertical-line-below" output="\m{vertical-line-below}"/>
