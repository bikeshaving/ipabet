    <key id="b_l" output="l"/>
    <key id="b_m" output="m"/>
    <key id="b_n" output="n"/>
    <key id="b_o" output="o"/>
    <key id="b_p" output="p"/>
    <key id="b_q" output="q"/>
    <key id="b_r" output="r"/>
