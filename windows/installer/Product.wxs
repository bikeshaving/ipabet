<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI. Per-machine, because a text service's profile is machine-wide and
  registering it needs administrator rights either way.

  Registration runs through ipabet-register.exe rather than through MSI's own
  self-registration, which is deprecated and would give the installer a second,
  divergent idea of what registering means. The DLL already knows; the installer
  asks it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="IPAbet"
           Manufacturer="Brian Kim"
           Version="$(var.Version)"
           UpgradeCode="8f3d5a21-6c74-4e90-9b12-3a7e5d0c4f88"
           Scope="perMachine"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades, because the product code is regenerated on
         every build: without it, reinstalling the same version leaves the old
         entry in Installed Apps and adds a second one beside it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of IPAbet is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="IpabetIcon" SourceFile="$(var.BinDir)\ipabet-register.exe" />
    <Property Id="ARPPRODUCTICON" Value="IpabetIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://ipabet.org" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="IPAbet">
        <Component Id="TextService">
          <File Id="IpabetDll" Source="$(var.BinDir)\ipabet.dll" KeyPath="yes" />
        </Component>
        <Component Id="Spec">
          <!-- Read at activation from beside the DLL: the tables are data, not
               code, and the same file ships on every platform. -->
          <File Id="IpabetJson" Source="$(var.BinDir)\ipabet.json" KeyPath="yes" />
        </Component>
        <Component Id="Registrar">
          <File Id="IpabetRegisterExe" Source="$(var.BinDir)\ipabet-register.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="IPAbet" Level="1">
      <ComponentRef Id="TextService" />
      <ComponentRef Id="Spec" />
      <ComponentRef Id="Registrar" />
    </Feature>

    <!-- Deferred and not impersonated: writing the profile needs the elevated
         half of the install, not the user's token. -->
    <CustomAction Id="RegisterTextService" FileRef="IpabetRegisterExe" ExeCommand=""
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UnregisterTextService" FileRef="IpabetRegisterExe" ExeCommand="--disable"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Unregister before the files go, or there is nothing left to ask. -->
      <Custom Action="UnregisterTextService" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RegisterTextService" After="InstallFiles"
              Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
