<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.bikeshaving.inputmethod.IPAbet</string>
    <key>CFBundleName</key>
    <string>IPA</string>
    <key>CFBundleDisplayName</key>
    <string>IPAbet</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Brian Kim. MIT License.</string>
    <key>CFBundleIconFile</key>
    <string>IPAbet</string>
    <key>tsInputMethodIconFileKey</key>
    <string>ipabet.pdf</string>
    <key>TISIconIsTemplate</key>
    <true/>
    <!-- Icon strategy (verified against KLInputSourceIconManager, macOS 15):
         the system typesets Apple IMEs' icons from TISIconLabels into a
         22×16pt rounded-rect badge, but hard-excludes third-party IMEs from
         that path; our files are drawn verbatim in every context. So
         ipabet.pdf mimics the composed badge, traced from a headless render
         of Korean's. NO ComponentInputModeDict: the mode-based registration
         (tried July 2026) phantom-enabled the source and wedged the Settings
         picker; the bundle-level source registers reliably and modes buy a
         single-mode IME nothing (label typesetting is Apple-gated anyway). -->

    <key>CFBundleExecutable</key>
    <string>IPAbet</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- LSUIElement, NOT LSBackgroundOnly: the modern IMK stack hosts input
         methods via ViewBridge, and background-only processes lose the event
         reply channel (dropped keys, IMKCFRunLoopWakeUpReliable errors).
         Squirrel sets LSBackgroundOnly=false explicitly; vChewing likewise. -->
    <key>LSUIElement</key>
    <true/>
    <key>LSBackgroundOnly</key>
    <false/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>TICapsLockLanguageSwitchCapable</key>
    <true/>
    <key>InputMethodConnectionName</key>
    <string>IPAbet_Connection</string>
    <key>InputMethodServerControllerClass</key>
    <string>InputController</string>
    <key>InputMethodServerDelegateClass</key>
    <string>InputController</string>
    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Latn</string>
    </array>
    <key>TISInputSourceID</key>
    <string>org.bikeshaving.inputmethod.IPAbet</string>
    <!-- "en", not "und-fonipa": IPAbet is a US keyboard with IPA on the
         shifted layers, and the picker groups by language — bare "und"
         made it hard to find. -->
    <key>TISIntendedLanguage</key>
    <string>en</string>
</dict>
</plist>
