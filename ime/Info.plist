<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.bikeshaving.inputmethod.IPAbet</string>
    <key>CFBundleName</key>
    <string>IPA</string>
    <key>CFBundleDisplayName</key>
    <string>IPAbet — IPA Transcription</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Brian Kim. MIT License.</string>
    <key>CFBundleIconFile</key>
    <string>IPAbet</string>
    <key>tsInputMethodIconFileKey</key>
    <string>ipabet.pdf</string>
    <key>TISIconIsTemplate</key>
    <true/>
    <!-- Icon strategy (verified against KLInputSourceIconManager, macOS 15):
         the system typesets Apple IMEs' icons from TISIconLabels into a
         22×16pt rounded-rect badge, but hard-excludes third-party IMEs from
         that path; our files are drawn verbatim in every context. So
         ipabet.pdf mimics the composed badge (traced from a headless render
         of Korean's), and ipabet-alt.pdf is the bare glyph for the
         fn/Ctrl-Space switcher (the Alternate key). TISIconLabels is kept
         in case Apple ever opens the gate. -->
    <key>ComponentInputModeDict</key>
    <dict>
        <key>tsInputModeListKey</key>
        <dict>
            <key>org.bikeshaving.inputmethod.IPAbet.IPA</key>
            <dict>
                <key>TISIconLabels</key>
                <dict>
                    <key>Primary</key>
                    <string>ə</string>
                </dict>
                <key>TISInputSourceID</key>
                <string>org.bikeshaving.inputmethod.IPAbet.IPA</string>
                <key>TISIntendedLanguage</key>
                <string>und-fonipa</string>
                <key>tsInputModeDefaultStateKey</key>
                <true/>
                <key>tsInputModeIsVisibleKey</key>
                <true/>
                <key>tsInputModeMenuIconFileKey</key>
                <string>ipabet.pdf</string>
                <key>tsInputModeAlternateMenuIconFileKey</key>
                <string>ipabet-alt.pdf</string>
                <key>tsInputModePaletteIconFileKey</key>
                <string>ipabet.pdf</string>
                <key>tsInputModePrimaryInScriptKey</key>
                <true/>
                <key>tsInputModeScriptKey</key>
                <string>smUnicodeScript</string>
            </dict>
        </dict>
        <key>tsVisibleInputModeOrderedArrayKey</key>
        <array>
            <string>org.bikeshaving.inputmethod.IPAbet.IPA</string>
        </array>
    </dict>
    <key>CFBundleExecutable</key>
    <string>IPAbet</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- LSUIElement, NOT LSBackgroundOnly: the modern IMK stack hosts input
         methods via ViewBridge, and background-only processes lose the event
         reply channel (dropped keys, IMKCFRunLoopWakeUpReliable errors).
         Squirrel sets LSBackgroundOnly=false explicitly; vChewing likewise. -->
    <key>LSUIElement</key>
    <true/>
    <key>LSBackgroundOnly</key>
    <false/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>TICapsLockLanguageSwitchCapable</key>
    <true/>
    <key>InputMethodConnectionName</key>
    <string>IPAbet_Connection</string>
    <key>InputMethodServerControllerClass</key>
    <string>InputController</string>
    <key>InputMethodServerDelegateClass</key>
    <string>InputController</string>
    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Latn</string>
    </array>
    <key>TISInputSourceID</key>
    <string>org.bikeshaving.inputmethod.IPAbet</string>
    <key>TISIntendedLanguage</key>
    <string>und-fonipa</string>
</dict>
</plist>
